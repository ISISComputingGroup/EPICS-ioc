
record(bo, "$(P)MOT:$(MOTOR_PV)_AUTOONOFF_CMD")
{
	field(DESC, "mtr auto on/off")
	field(ZNAM, "Off")
	field(ONAM, "On")
	field(OUT, "$(P)$(I):ASTAXES_$(AXIS_NUM):STCONTROL-BAUTOENABLEDISABLE")
	field(FLNK, "$(P)$(I):ASTAXES_$(AXIS_NUM):STCONTROL-BAUTOENABLEDISABLE")
	field(PINI, "YES")
    field(VAL, "1")
} 

record(bi, "$(P)MOT:$(MOTOR_PV)_AUTOONOFF_STATUS")
{
	field(DESC, "mtr auto on/off")
	field(ZNAM, "Off")
  	field(ONAM, "On")
   	field(INP,  "$(P)$(I):ASTAXES_$(AXIS_NUM):STCONTROL-BAUTOENABLEDISABLE:RBV CP")
	field(PINI, "YES")
}

record(bi,"$(P)MOT:$(MOTOR_PV)_ON_STATUS")
{
    field(INP, "$(P)$(I):ASTAXES_$(AXIS_NUM):STSTATUS-BENABLED CP")
	field(DESC, "Mtr on status")
	field(ZNAM, "Off")
   	field(ZSV,  "MINOR")
  	field(ONAM, "On")
  	field(OSV,  "NO_ALARM")
}

record(bo, "$(P)MOT:$(MOTOR_PV)_ON_CMD")
{
    field(DESC, "Fwd to PLC BENABLE")
    field(OUT, "$(P)$(I):ASTAXES_$(AXIS_NUM):STCONTROL-BENABLE PP")
}

record(stringout, "$(P)MOT:$(MOTOR_PV):DESC_SEND")
{
    field(DESC, "Forward axis description to mtr rec")
    field(DOL, "$(P)$(I):ASTAXES_$(AXIS_NUM):STDESC-SAXISNAME CP")
    field(OUT, "$(P)MOT:$(MOTOR_PV).DESC")
    field(OMSL, "closed_loop")
}

record(longin, "$(P)MOT:$(MOTOR_PV)_AXIS_NUM")
{
    field(DESC, "Beckhoff axis number")
    field(VAL, "$(AXIS_NUM)")
}
