record(ao, "$(P)STEER_$(STEER_MAG):$(INT_MAG)_$(DIRECTION):COEFF")
{
  field(DESC, "Coefficient for steering $(STEER_MAG) $(INT_MAG)_$(DIRECTION)")
  field(PREC, "3")
  info(autosaveFields, "VAL")
  info(INTEREST, "LOW")
  field(EGU, "")
  field(UDFS, "NO_ALARM")
}

# Equation for a single steering magnet 
# bx = ax + (cx1 * m1 + cx2 * m2 +... + cxn * mn)
# where b = The output steering value
# a = the initital steering value
# x = the steering magnet
# cx1 through cxn = the coefficients of the interfering magnets to steering magnet x (set by scientists)
# m1 through mn = the current value of the interferring magnets

record(calc, $(P)STEERING_$(STEER_MAG):$(DIRECTION)_$(INT_MAG)){
  field(DESC, "$(INT_MAG) $(DIRECTION) X Coeff for STEER $(STEER_MAG)")
  field(CALC, "A*B")
  field(INPA, "$(P)STEER_$(STEER_MAG):$(INT_MAG)_$(DIRECTION):COEFF CP MS")
  field(INPB, "$(P)$(INT_MAG)_PV:$(DIRECTION) CP MS")
}

record(calc, "$(P)STEERING_$(STEER_MAG):OFFSET"){
  field(DESC, "Offset for steer magnet $(STEER_MAG)")
  field(CALC, "A + B + C + D + E + F + G")
  field(PREC, "3")
  field(INP$(INP), "$(P)STEERING_$(STEER_MAG):$(DIRECTION)_$(INT_MAG) CP MS")
  info(INTEREST, "LOW")
  field(ASG, "READONLY")
}
