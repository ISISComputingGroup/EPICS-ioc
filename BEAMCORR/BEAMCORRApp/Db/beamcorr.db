### Generic Records

record(bo, "$(P)SIM")
{
    field(SCAN, "Passive")
    field(DTYP, "Soft Channel")
    field(ZNAM, "NO")
    field(ONAM, "YES")
    field(VAL, "$(RECSIM)")
}

record(bo, "$(P)DISABLE") 
{
    field(DESC, "Disable comms")
    field(PINI, "YES")
    field(VAL, "$(DISABLE)")
    field(OMSL, "supervisory")
    field(ZNAM, "COMMS ENABLED")
    field(ONAM, "COMMS DISABLED")
}

### Enable Beam Corrections

record(bo, "$(P)ENABLE:CORR")
{
  field(DESC, "Enable Beam Corrections")
  field(ZNAM, "DISABLED")
  field(ONAM, "ENABLED")
}

record(ao, "$(P)NUM:STEER_MAG"){
  field(DESC, "Number of Steering Magnets")
  field(VAL, "$(NUM_STEER)")
}

# Equation for a single steering magnet offset
# bx = ax + (cx1 * m1 + cx2 * m2 +... + cxn * mn)
# where b = The output steering value
# a = the initital steering value
# x = the steering magnet
# cx1 through cxn = the coefficients of the interfering magnets to steering magnet x (set by scientists)
# m1 through mn = the current value of the interferring magnets

record(ai, "$(P)HIFI_PV:MAIN"){
  field(INP, "$(HIFI_PV_MAIN) CP MS")
  field(SIOL, "$(P)SIM:HIFI_PV:MAIN")
  field(SIML, "$(P)SIM")
}

record(stringout, "$(P)HIFI_PV:MAIN:UNITS_SET")
{
  field(DESC, "Push units from one pv to another")
  field(DOL, "$(HIFI_PV_MAIN).EGU CP")
	field(OMSL, "closed_loop")
  field(OUT,  "$(P)HIFI_PV:MAIN.EGU NPP")
  field(SIOL, "$(P)SIM:HIFI_PV:MAIN:UNITS_SET PP")
  field(SIML, "$(P)SIM")
}

record(ai, "$(P)HIFI_PV:TRANS"){
  field(INP, "$(HIFI_PV_TRANS) CP MS")
  field(SIOL, "$(P)SIM:HIFI_PV:TRANS")
  field(SIML, "$(P)SIM")
