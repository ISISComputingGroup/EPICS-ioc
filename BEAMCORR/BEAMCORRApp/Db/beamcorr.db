record(calcout, "$(P)MUSR_ROTATION:ISLONG"){
  field(DESC, "Handle MUSR Direction")
  field(CALC, "(A==0)?B:0")
$(IFNOTRECSIM="")  field(INPA, "IN:MUSR:MUSR_ROTATION CP MS")
$(IFRECSIM="")  field(INPA, "$(P)SIM:MUSR_ROTATION CP MS")
$(IFNOTRECSIM="")  field(INPB, "$(MUSR_PV_MAIN) CP MS")
$(IFRECSIM="")  field(INPB, "$(P)SIM:MUSR_PV:MAIN CP MS")
  field(OUT, "$(P)MUSR_PV:MAIN PP")
}

record(calcout, "$(P)MUSR_ROTATION:ISTRANS"){
  field(DESC, "Handle MUSR Direction")
  field(CALC, "(A==1)?B:0")
$(IFNOTRECSIM="")  field(INPA, "IN:MUSR:MUSR_ROTATION CP MS")
$(IFRECSIM="")  field(INPA, "$(P)SIM:MUSR_ROTATION CP MS")
$(IFNOTRECSIM="")field(INPB, "$(MUSR_PV_MAIN) CP MS")
$(IFRECSIM="")  field(INPB, "$(P)SIM:MUSR_PV:MAIN CP MS")
  field(OUT, "$(P)MUSR_PV:TRANS PP")
}

### Sim Records

record(mbbo, "$(P)SIM:MUSR_ROTATION"){
  field(DESC, "SIM MUSR Direction for testing")
  field(ZRST, "Longitudinal")
  field(ONST, "Transverse")
  field(TWST, "Indeterminate")
}

