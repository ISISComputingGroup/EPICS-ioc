# PLC records:

record(bo, "$(P)IS300") {
	field(VAL, "1")
	field(PINI, "YES")
}

record(mbbi, "$(P)PLC:HIGH_VACUUM_VALVE") {
    field(DTYP, "OPCUA")
    field(INP,  "@$(SUBS) ns=$(NS);s=Opc_GV2_STATUS")
    field(SCAN, "I/O Intr")
	field(ZRVL, "0")
	field(ZRST, "Comm Lost")
	field(ONVL, "1")
	field(ONST, "Closed")
	field(TWVL, "2")
	field(TWST, "Opened")
	field(THVL, "3")
	field(THST, "Swiping")
	field(FRVL, "4")
	field(FRST, "Position Error")
    field(TSE,  "-2")
    field(TPRO, "$(DEBUG=0)")
}

record(mbbi, "$(P)$(R1):ERROR") {
	field(DTYP, "OPCUA")
	field(INP, "@$(SUBS) ns=$(NS);s=OPC_TPG1_DATA.ALARM_ACTIVE")
	field(ZRVL, "0")
	field(ZRST, "No Error")
	field(ONVL, "1")
	field(ONST, "Some Error")
	field(TSE,  "-2")
    field(TPRO, "$(DEBUG=0)")
}

